<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!-- NuGet Package Metadata -->
        <PackageId>R4PDF</PackageId>
        <Version>1.2.0</Version>
        <Authors>R4PDF Contributors</Authors>
        <Description>Convert JSON templates into fully customizable PDFs. Template-driven PDF generation with support for text, tables, images, headers/footers, and rich styling.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://ruben-vermeulen.nl/r4pdf</PackageProjectUrl>
        <RepositoryUrl>https://github.com/RubenZkr/R4PDF</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>1.2.0: long words break within their column, per-cell styles and badges, anchors with GenerateWithLayout and links, the canvas element for diagrams, and keepWithNext.</PackageReleaseNotes>
        <PackageTags>pdf;json;pdf-generation;template;report</PackageTags>
        <IsPackable>true</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="\"/>
        <PackageReference Include="PdfSharpCore" Version="1.3.67"/>
        <!-- PdfSharpCore pulls in ImageSharp 1.0.4, which has known vulnerabilities; pin a patched 2.1.x (Apache-2.0). -->
        <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13"/>
    </ItemGroup>

</Project>
